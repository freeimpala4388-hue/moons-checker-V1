# -----------------------------
# Fog Background
# -----------------------------

fog = []

def create_fog():

    for i in range(30):

        x = random.randint(0,600)
        y = random.randint(0,500)

        size = random.randint(120,260)

        color = random.choice(["#552bff","#2d6cff"])

        f = canvas.create_oval(x,y,x+size,y+size,
                               fill=color,
                               outline="")

        fog.append([f,random.uniform(.2,.6)])


def animate_fog():

    for f,s in fog:

        canvas.move(f,s,0)

        pos = canvas.coords(f)

        if pos[0] > 600:

            canvas.coords(f,-200,pos[1],0,pos[3])

    root.after(50,animate_fog)

# -----------------------------
# Loading System
# -----------------------------

def start_loading():

    progress = 0

    def load():

        nonlocal progress

        progress += 1

        bar_canvas.coords(load_bar,0,0,progress*5,20)

        percent_label.config(text=f"{progress}%")

        if progress < 100:
            root.after(25,load)
        else:
            finish_loading()

    load()


def finish_loading():

    canvas.delete(loading_window)

    canvas.itemconfigure(menu_window,state="normal")

