# -----------------------------
# Roblox API
# -----------------------------

def get_user_id(username):

    url = "https://users.roblox.com/v1/usernames/users"

    data = {
        "usernames":[username],
        "excludeBannedUsers":False
    }

    r = requests.post(url,json=data).json()

    if r["data"]:
        return r["data"][0]["id"]

    return None


def get_user_info(user_id):

    url = f"https://users.roblox.com/v1/users/{user_id}"

    return requests.get(url).json()


def check_gamepass(user_id,gamepass):

    url = f"https://inventory.roblox.com/v1/users/{user_id}/items/GamePass/{gamepass}"

    r = requests.get(url).json()

    return r.get("data") != []

# -----------------------------
# CHECK USER
# -----------------------------

def check_user():

    username = username_box.get()
    gamepass = gamepass_box.get()

    log.delete("1.0",tk.END)

    try:

        user_id = get_user_id(username)

        if not user_id:
            log.insert(tk.END,"User not found")
            return

        info = get_user_info(user_id)

        owns = check_gamepass(user_id,gamepass)

        log.insert(tk.END,f"Real Username: {username}\n")
        log.insert(tk.END,f"Display Name: {info['displayName']}\n")
        log.insert(tk.END,f"User ID: {user_id}\n")
        log.insert(tk.END,f"Gamepass Owned: {owns}")

    except:

        log.insert(tk.END,"Error checking user")

